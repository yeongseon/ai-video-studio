# ==============================================================================
# AI Video Studio — Environment Configuration
# ==============================================================================
# Variables are marked:
#   REQUIRED  — must be set for the application to start
#   OPTIONAL  — has a sensible default; override only if needed
#   CONDITIONAL — required only when a specific feature/backend is enabled
# ==============================================================================

# --- Environment Mode ---
# OPTIONAL: 'development' (default) or 'production'.
# Production mode enables startup safety checks (rejects default passwords,
# enforces API_KEY and CORS_ORIGINS).
ENVIRONMENT=development

# --- Database ---
# REQUIRED: PostgreSQL connection details.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=short_form_studio
POSTGRES_USER=short_form_user
POSTGRES_PASSWORD=change-me-before-use
DATABASE_URL=postgresql://short_form_user:change-me-before-use@postgres:5432/short_form_studio

# OPTIONAL: DB connection pool size (asyncpg). Tune for production workloads.
# DB_POOL_MIN_SIZE=2
# DB_POOL_MAX_SIZE=10

# --- Redis ---
# REQUIRED: Redis connection for Celery task queue.
# Unset REDIS_URL to run in lightweight (synchronous) mode without Celery.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
# OPTIONAL: Maximum bytes retained in the DLQ fallback before one-segment rotation.
# DLQ_FALLBACK_MAX_BYTES=10485760

# --- API Server ---
# OPTIONAL: Bind address and port for the FastAPI server.
API_HOST=0.0.0.0
API_PORT=8000
# REQUIRED in production: Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5174

# --- Artifact Storage ---
# OPTIONAL: Path for generated artifacts (videos, images, audio).
ARTIFACT_ROOT=./data/artifacts
# OPTIONAL: Compose host bind source; container path stays /app/data/artifacts.
# Must be absolute or start with ./; do not put the host path in ARTIFACT_ROOT.
# Read Local Storage before changing an existing installation.
# ARTIFACTS_HOST_DIR=./data/artifacts

# OPTIONAL: Artifact retention window in days. Artifacts older than this
# are marked for deletion by the sweep_expired_artifacts beat task
# (runs every 10 minutes) and then removed from storage by the
# retry_failed_artifact_deletions task. Values <= 0 fall back to the
# default of 90 days; set expires_at = NULL explicitly on a row to
# exempt it from expiry.
# Default: 90
# ARTIFACT_RETENTION_DAYS=90

# OPTIONAL: Workspace media budgets. Zero disables each limit so existing
# installations remain backward compatible. Admission atomically checks stored
# plus in-flight reserved bytes and asset slots.
# MEDIA_MAX_STORED_BYTES=0
# MEDIA_MAX_ASSET_COUNT=0
# MEDIA_MAX_RESERVED_BYTES=0

# OPTIONAL: Minimum free bytes to keep on the temp (scratch) filesystem. New media
# staging is blocked when an upload would drop it below this, and render, image and
# audio jobs are refused before they start while it is below this. Reads, downloads,
# and cleanup remain available. Zero disables the check.
# MEDIA_TEMP_DISK_LOW_WATERMARK_BYTES=0

# OPTIONAL: Absolute private render scratch directory outside ARTIFACT_ROOT (SSD
# recommended). Unset preserves existing placement; the job scratch floor above
# checks both this directory and system temp when set. Mount it into every rendering process first.
# RENDER_SCRATCH_DIR=/var/cache/ai-video-studio/render
# Per-delivery polled scratch limit (2 GiB default; 0 disables). Existing outputs are preserved.
# A Timeline copies its source media into scratch and counts it: raise this for projects with several large videos.
# RENDER_SCRATCH_MAX_BYTES=2147483648
# Worker-start cleanup only; 0 max age disables age cleanup, not same-host dead-owner cleanup.
# ENABLED accepts 1/true/yes or 0/false/no (case-insensitive); invalid uses true + warning.
# Integers: ASCII decimal digits, surrounding whitespace ignored; positive except max age allows 0.
# Signs, underscores, non-ASCII digits or invalid values use defaults + one warning each.
# Dead-owner checks assume one pid namespace per hostname; keep container hostnames unique.
# Solo render pools do not enforce Celery time limits: keep age above legitimate render duration.
# Recognised-candidate budgets are per root (scratch first); removal/time budgets are global and cooperative.
# RENDER_SCRATCH_SWEEP_ENABLED=true
# RENDER_SCRATCH_MAX_AGE_SECONDS=3600
# RENDER_SCRATCH_SWEEP_MIN_GRACE_SECONDS=60
# RENDER_SCRATCH_SWEEP_MAX_RUN_DIRECTORIES=1000
# RENDER_SCRATCH_SWEEP_MAX_ENTRIES=10000
# RENDER_SCRATCH_SWEEP_MAX_REMOVALS=500
# RENDER_SCRATCH_SWEEP_BUDGET_SECONDS=20

# OPTIONAL: Minimum free bytes to keep on the filesystem that holds ARTIFACT_ROOT.
# Render, image and audio jobs are refused before they write anything while it is
# below this; existing artifacts are never purged to make room. Zero disables it.
# MEDIA_ARTIFACT_DISK_LOW_WATERMARK_BYTES=0

# OPTIONAL: MediaAsset retention is disabled and dry-run by default. Configure
# positive, kind-specific windows and explicitly enable it before candidates are
# reported. Set DRY_RUN=false only after reviewing the grace-period candidates.
MEDIA_RETENTION_ENABLED=false
MEDIA_RETENTION_DRY_RUN=true
# MEDIA_RETENTION_ORIGINAL_DAYS=0
# MEDIA_RETENTION_INTERMEDIATE_DAYS=0
# MEDIA_RETENTION_FINAL_VIDEO_DAYS=0
MEDIA_RETENTION_GRACE_DAYS=7

# OPTIONAL: Memory limit for API and worker containers (MB).
# Enforced via Docker cgroup (deploy.resources.limits.memory), NOT RLIMIT_AS.
# RLIMIT_AS caused MemoryError on CUDA/torch/ffmpeg which reserve large
# virtual address ranges. API default: 1024, worker default: 4096.
# MAX_MEMORY_MB=4096
# OPTIONAL: Independent Compose limits in MiB, also passed as container MAX_MEMORY_MB.
# Each falls back to legacy MAX_MEMORY_MB when unset or empty, then its default.
# API_MAX_MEMORY_MB=1024
# WORKER_MAX_MEMORY_MB=4096

# OPTIONAL: Object storage backend. Default 'local' stores on filesystem.
STORAGE_BACKEND=local           # 'local', 's3', or 'azure_blob'
# CONDITIONAL: Required when STORAGE_BACKEND=s3
# AWS_S3_BUCKET=my-artifacts
# AWS_S3_REGION=us-east-1
# AWS_S3_PREFIX=
# CONDITIONAL: Required when STORAGE_BACKEND=azure_blob
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=artifacts

# --- Local AI Services (GPU profile) ---
# OPTIONAL: Base URLs for self-hosted AI services. Only needed with `--profile gpu`.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=qwen3:4b

STABLE_DIFFUSION_BASE_URL=http://stable-diffusion:7860
STABLE_DIFFUSION_DEFAULT_MODEL=sd15

TTS_QWEN3_BASE_URL=http://tts-qwen3:8100
TTS_DEFAULT_VOICE=default
TTS_DEFAULT_LANGUAGE=ko

STT_WHISPER_BASE_URL=http://stt-whisper:8200
STT_DEFAULT_MODEL=whisper-small

# --- External API Provider Keys ---
# OPTIONAL: Disable all NEW billable provider calls without affecting reads or downloads.
BILLABLE_PROVIDER_CALLS_ENABLED=true
# OPTIONAL: Global monthly ceiling for estimated spend across workspaces.
# Estimates are conservative admission controls, not provider invoices.
# GLOBAL_MONTHLY_ESTIMATED_BUDGET_USD=500.00

# CONDITIONAL: Set at least one LLM provider key if not using local Ollama.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# CONDITIONAL: Set if using remote image generation.
STABILITY_API_KEY=
# CONDITIONAL: Set if using remote TTS.
ELEVENLABS_API_KEY=
# OPTIONAL: Groq API for fast inference (alternative LLM provider).
GROQ_API_KEY=

# --- GPU Lock ---
# OPTIONAL: Coordination key and timeout for GPU resource locking.
GPU_LOCK_KEY=gpu:lock
GPU_LOCK_TIMEOUT_SECONDS=600

# --- Authentication ---
# REQUIRED: DB-backed API key for creator endpoints.
# Generate via: docker compose run --rm api python scripts/create_api_key.py \
#   --email local@example.com --workspace local --name local-dev
# The API validates keys via SHA-256 hash lookup in the api_keys table.
# The value below is a PLACEHOLDER; it will NOT work until you run create_api_key.py.
API_KEY=<replace-with-generated-key>

# --- Admin ---
# OPTIONAL: Admin API key for /api/admin/* endpoints. Leave empty to disable admin access.
ADMIN_API_KEY=

# --- OpenTelemetry ---
# OPTIONAL: Enable distributed tracing and structured logging.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=short-form-studio
OTEL_ENVIRONMENT=development
